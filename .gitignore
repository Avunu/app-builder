# Each addon's `build` script (its package.json) compiles every .ts under
# static/ to the .js beside it. Odoo's own transpiler then treats that .js as
# an @odoo-module, which is why it lives in static/src and not static/dist.
# Nix rebuilds it into the deployed tree (docs: odoo-nix, Addon frontends).
/app_builder*/static/src/**/*.js
/app_builder*/static/tests/**/*.js
