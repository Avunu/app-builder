<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_studio_user" model="res.groups">
        <field name="name">Studio Builder</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Can build models, fields and views through the studio.</field>
    </record>

    <record id="group_studio_manager" model="res.groups">
        <field name="name">Studio Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_studio_user'))]"/>
        <field name="comment">Can additionally write packages to disk and reload modules.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_studio_manager'))]"/>
    </record>
</odoo>
