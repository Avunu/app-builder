<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="group_builder_user" model="res.groups">
        <field name="name">Builder User</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field
            name="comment"
        >Can build models, fields and views through the builder.</field>
    </record>

    <record id="group_builder_manager" model="res.groups">
        <field name="name">Builder Administrator</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="implied_ids" eval="[(4, ref('group_builder_user'))]" />
        <field
            name="comment"
        >Can additionally write packages to disk and reload modules.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_builder_manager'))]" />
    </record>
</odoo>
