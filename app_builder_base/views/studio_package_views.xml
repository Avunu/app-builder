<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="studio_package_view_list" model="ir.ui.view">
        <field name="name">studio.package.list</field>
        <field name="model">studio.package</field>
        <field name="arch" type="xml">
            <list string="Studio Packages" decoration-warning="state == 'drifted'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="display_name_"/>
                <field name="version"/>
                <field name="record_count"/>
                <field name="git_branch"/>
                <field name="writable" widget="boolean_toggle" readonly="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'synced'"
                       decoration-warning="state == 'drifted'"
                       decoration-danger="state == 'missing'"/>
            </list>
        </field>
    </record>

    <record id="studio_package_view_form" model="ir.ui.view">
        <field name="name">studio.package.form</field>
        <field name="model">studio.package</field>
        <field name="arch" type="xml">
            <form string="Studio Package">
                <header>
                    <button name="action_write_files" type="object" string="Write to disk"
                            class="btn-primary" invisible="not writable"/>
                    <button name="action_reload" type="object" string="Reload from disk"
                            class="btn-secondary"/>
                    <button name="action_check_drift" type="object" string="Check drift"/>
                    <button name="action_delete_records" type="object"
                            string="Delete records" class="btn-secondary"
                            confirm="This removes every record this package owns from
                                     the database. The source files are left alone, so
                                     you can reinstall the module to get them back.
                                     Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,synced,drifted"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="writable">
                        This package directory is read-only. That is expected on a
                        production deployment: build packages in development and
                        ship them through git.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'drifted'">
                        Files on disk no longer match what the builder generated —
                        somebody edited them by hand. Use <b>Reload from disk</b> to
                        adopt those edits, or <b>Write to disk</b> to overwrite them.
                    </div>
                    <div class="oe_title">
                        <label for="display_name_"/>
                        <h1><field name="display_name_" placeholder="My Customizations"/></h1>
                        <label for="name"/>
                        <h2><field name="name" placeholder="x_my_customizations"/></h2>
                    </div>
                    <group>
                        <group string="Manifest">
                            <field name="summary"/>
                            <field name="version"/>
                            <field name="category"/>
                            <field name="author"/>
                            <field name="license"/>
                            <field name="depends"/>
                        </group>
                        <group string="Location">
                            <field name="root_path"/>
                            <field name="writable"/>
                            <field name="record_count"/>
                            <field name="is_git"/>
                            <field name="git_branch" invisible="not is_git"/>
                            <field name="auto_commit" invisible="not is_git"/>
                            <field name="python_models"
                                   invisible="not python_models"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Generated files" name="files">
                            <field name="file_ids" readonly="1">
                                <list decoration-warning="drifted">
                                    <field name="path"/>
                                    <field name="drifted"/>
                                    <field name="generated_checksum" optional="hide"/>
                                    <field name="disk_checksum" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="studio_package_action" model="ir.actions.act_window">
        <field name="name">Studio Packages</field>
        <field name="res_model">studio.package</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first studio package</p>
            <p>A package is one Odoo addon directory. Everything you build in the
               studio is written into it as ordinary source files you can review,
               diff and commit.</p>
        </field>
    </record>
</odoo>
