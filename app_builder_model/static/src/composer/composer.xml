<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="app_builder_model.StudioComposer">
    <div class="o_studio_composer d-flex flex-column h-100">

        <div class="o_studio_composer_bar d-flex align-items-center gap-2 px-3 py-2 border-bottom">
            <span class="fw-bold" t-esc="data.model"/>
            <small class="text-muted" t-esc="data.package and data.package.name"/>
            <span t-if="changeCount" class="badge text-bg-warning">
                <t t-esc="changeCount"/> pending
            </span>
            <div class="flex-grow-1"/>
            <button class="btn btn-secondary btn-sm" t-if="changeCount"
                    t-on-click="() => this.showDiff()">Review</button>
            <button class="btn btn-secondary btn-sm" t-if="changeCount"
                    t-on-click="() => this.onDiscard()">Discard</button>
            <button class="btn btn-primary btn-sm" t-att-disabled="!canApply"
                    t-on-click="() => this.onApply()">
                <span t-if="state.applying" class="fa fa-circle-o-notch fa-spin me-1"/>
                Apply
            </button>
        </div>

        <div t-if="!data.package or !data.package.writable"
             class="alert alert-warning rounded-0 mb-0" role="alert">
            This package is read-only, so nothing can be applied. That is normal on
            a production deployment: build in development and ship through git.
        </div>

        <div t-if="errors.length" class="alert alert-danger rounded-0 mb-0" role="alert">
            <div t-foreach="errors" t-as="error" t-key="error_index" t-esc="error"/>
        </div>

        <div class="d-flex flex-grow-1 overflow-hidden">
            <ResizablePanel initialWidth="420" minWidth="320" handleSide="'end'"
                            class="'o_studio_composer_side border-end'">
                <div class="d-flex flex-column h-100">

                    <ul class="nav nav-tabs px-2 pt-2">
                        <li class="nav-item">
                            <a class="nav-link" href="#"
                               t-att-class="{active: state.tab === 'fields'}"
                               t-on-click.prevent="() => this.state.tab = 'fields'">Fields</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"
                               t-att-class="{active: state.tab === 'pending'}"
                               t-on-click.prevent="() => this.state.tab = 'pending'">
                                Pending
                                <span t-if="changeCount" class="badge text-bg-secondary ms-1"
                                      t-esc="changeCount"/>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"
                               t-att-class="{active: state.tab === 'source'}"
                               t-on-click.prevent="() => this.showDiff()">Source</a>
                        </li>
                    </ul>

                    <div class="flex-grow-1 overflow-auto p-2">

                        <t t-if="state.tab === 'fields'">
                            <div t-foreach="fields" t-as="field" t-key="field.name"
                                 class="o_studio_field d-flex align-items-center gap-2 px-2 py-1 rounded">
                                <div class="flex-grow-1 text-truncate">
                                    <div t-esc="field.string or field.name"/>
                                    <small class="text-muted">
                                        <t t-esc="field.type_label"/>
                                        <t t-if="field.comodel"> → <t t-esc="field.comodel"/></t>
                                    </small>
                                </div>
                                <button class="btn btn-link btn-sm p-1" title="Move up"
                                        t-on-click="() => this.onMoveUp(field.name)">
                                    <i class="oi oi-chevron-up"/>
                                </button>
                                <button class="btn btn-link btn-sm p-1" title="Move down"
                                        t-on-click="() => this.onMoveDown(field.name)">
                                    <i class="oi oi-chevron-down"/>
                                </button>
                                <button class="btn btn-link btn-sm p-1" title="Edit"
                                        t-on-click="(ev) => this.openField(ev, field.name)">
                                    <i class="fa fa-pencil"/>
                                </button>
                            </div>

                            <button class="btn btn-light w-100 mt-2"
                                    t-on-click="(ev) => this.openField(ev, null)">
                                <i class="fa fa-plus me-1"/> Add a field
                            </button>

                            <div class="text-muted small mt-3 px-2">
                                Fields appear in this order in the generated class and
                                in the views it scaffolds.
                            </div>
                        </t>

                        <t t-if="state.tab === 'pending'">
                            <div t-if="!pending.length" class="text-muted p-2">
                                Nothing staged. Changes collect here until you apply them.
                            </div>
                            <div t-foreach="pending" t-as="change" t-key="change_index"
                                 class="d-flex align-items-start gap-2 py-1">
                                <span class="badge"
                                      t-att-class="{
                                        'text-bg-success': change.kind === 'added',
                                        'text-bg-info': change.kind === 'changed',
                                        'text-bg-danger': change.kind === 'removed',
                                        'text-bg-secondary': change.kind === 'model'}"
                                      t-esc="change.kind"/>
                                <div>
                                    <div>
                                        <t t-esc="change.name"/>
                                        <span t-if="change.model" class="badge text-bg-light ms-1"
                                              t-esc="change.model"/>
                                    </div>
                                    <small class="text-muted" t-esc="change.detail"/>
                                </div>
                            </div>
                            <div t-if="pending.length" class="alert alert-light mt-3 mb-0 small">
                                <t t-esc="reloadNotice"/>
                            </div>
                        </t>

                        <t t-if="state.tab === 'source'">
                            <div t-if="!state.diff" class="text-muted p-2">
                                No difference: the file already says this.
                            </div>
                            <pre t-if="state.diff" class="o_studio_diff small mb-0"
                                 t-esc="state.diff"/>
                        </t>

                    </div>
                </div>
            </ResizablePanel>

            <div class="flex-grow-1 overflow-auto position-relative">
                <div class="o_studio_preview_note text-muted small px-3 py-1 border-bottom">
                    Live preview of the form as it is now.
                    <t t-if="changeCount">
                        Pending changes are not shown until they are applied — a field
                        the server does not have yet cannot be rendered.
                    </t>
                </div>
                <View t-if="data.view and data.view.available" t-key="state.previewKey"
                      resModel="data.view.res_model" type="'form'"/>
                <div t-if="data.view and !data.view.available"
                     class="alert alert-info m-3" role="alert"
                     t-esc="data.view.reason"/>
            </div>
        </div>
    </div>
</t>

</templates>
