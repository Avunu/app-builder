<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The list of models the builder owns, and the way into the composer.
        A studio.package.model row carries where its definition lives, which is
        what decides whether it can be composed at all.
    -->
    <record id="studio_package_model_view_list" model="ir.ui.view">
        <field name="name">studio.package.model.list</field>
        <field name="model">studio.package.model</field>
        <field name="arch" type="xml">
            <list string="Models" create="0">
                <field name="package_id"/>
                <field name="model"/>
                <field name="source" widget="badge"
                       decoration-success="source == 'python'"
                       decoration-warning="source == 'frozen'"/>
                <field name="parse_error" optional="hide"/>
                <button name="action_compose" type="object" icon="fa-pencil"
                        string="Compose" invisible="source != 'python'"/>
                <button name="action_retry_parse" type="object" icon="fa-refresh"
                        string="Re-read the file" invisible="source != 'frozen'"/>
            </list>
        </field>
    </record>

    <record id="studio_package_model_view_form" model="ir.ui.view">
        <field name="name">studio.package.model.form</field>
        <field name="model">studio.package.model</field>
        <field name="arch" type="xml">
            <form string="Model">
                <header>
                    <button name="action_compose" type="object" string="Compose"
                            class="btn-primary" invisible="source != 'python'"/>
                    <button name="action_retry_parse" type="object"
                            string="Re-read the file" invisible="source != 'frozen'"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="source != 'frozen'">
                        The builder stopped rewriting this file because it could not
                        read its block. Nothing has been lost — the file is left
                        exactly as it is. Fix the block and re-read it.
                        <div class="mt-1"><field name="parse_error" nolabel="1" readonly="1"/></div>
                    </div>
                    <group>
                        <field name="package_id"/>
                        <field name="model"/>
                        <field name="source"/>
                        <field name="python_path"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        A record, not just a tag, so the composer has a stable URL. Apply
        rebuilds the registry; a page that could not be reopened from its
        address would lose the session on every save.
    -->
    <record id="action_composer" model="ir.actions.client">
        <field name="name">Compose Model</field>
        <field name="tag">app_builder_composer</field>
    </record>

    <record id="studio_package_model_action" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">studio.package.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build your first model</p>
            <p>Studio → New Model creates one, along with the views, menu and
               access rules that make it usable.</p>
        </field>
    </record>

    <menuitem id="menu_studio_models"
              name="Models"
              parent="app_builder_base.menu_studio_root"
              action="studio_package_model_action"
              sequence="25"/>

</odoo>
