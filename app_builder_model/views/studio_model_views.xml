<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="studio_model_wizard_view_form" model="ir.ui.view">
        <field name="name">studio.model.wizard.form</field>
        <field name="model">studio.model.wizard</field>
        <field name="arch" type="xml">
            <form string="New Model">
                <group>
                    <field name="package_id"/>
                    <field name="name" placeholder="Workshop Job"/>
                    <field name="model" placeholder="left empty, derived from the label"/>
                </group>
                <group string="Include">
                    <field name="add_chatter"/>
                    <field name="add_stage"/>
                    <field name="add_user"/>
                    <field name="add_contact"/>
                    <field name="add_date"/>
                    <field name="add_date_range"/>
                    <field name="add_monetary"/>
                    <field name="add_picture"/>
                    <field name="add_company"/>
                    <field name="add_tags"/>
                    <field name="add_lines"/>
                    <field name="add_reference"/>
                    <field name="add_ordering"/>
                    <field name="add_active"/>
                    <field name="add_description"/>
                </group>
                <group string="Access">
                    <field name="groups_ids" widget="many2many_tags"
                           placeholder="Internal User"/>
                </group>
                <div class="alert alert-info" role="alert">
                    This writes a real Python model, its views, an action, a
                    menu and access rules, then reloads the package so you can
                    use it straight away. Only the marked block inside the
                    generated class belongs to the builder — the rest of the
                    file is yours.
                </div>
                <footer>
                    <button name="action_create" type="object" string="Create"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="studio_model_wizard_action" model="ir.actions.act_window">
        <field name="name">New Model</field>
        <field name="res_model">studio.model.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="studio_field_wizard_view_form" model="ir.ui.view">
        <field name="name">studio.field.wizard.form</field>
        <field name="model">studio.field.wizard</field>
        <field name="arch" type="xml">
            <form string="New Field">
                <group>
                    <field name="package_id"/>
                    <field name="model_id"/>
                    <field name="field_description" placeholder="Customer"/>
                    <field name="name" placeholder="x_customer_id"/>
                    <field name="ttype"/>
                    <field name="relation"
                           invisible="ttype not in ('many2one', 'one2many', 'many2many')"
                           required="ttype in ('many2one', 'one2many', 'many2many')"/>
                    <field name="relation_field"
                           invisible="ttype != 'one2many'"
                           required="ttype == 'one2many'"/>
                    <field name="required"/>
                    <field name="store"/>
                </group>
                <group string="Computed value">
                    <field name="compute" widget="ace" options="{'mode': 'python'}"/>
                    <field name="depends"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="studio_field_wizard_action" model="ir.actions.act_window">
        <field name="name">New Field</field>
        <field name="res_model">studio.field.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="studio_adopt_wizard_view_form" model="ir.ui.view">
        <field name="name">studio.adopt.wizard.form</field>
        <field name="model">studio.adopt.wizard</field>
        <field name="arch" type="xml">
            <form string="Adopt an existing model">
                <div class="alert alert-info" role="alert">
                    New models are already Python. This is for the ones that
                    are not yet — an <code>x_</code> model built by an older
                    version of the studio, or made by hand in Settings →
                    Technical. The records, the table and its data are
                    untouched; only where the definition lives changes.
                    <b>Afterwards it behaves like any other model the builder
                    owns</b>: the marked block inside its class stays in sync
                    and everything outside it is yours. Takes effect once the
                    package reloads, which <code>--dev=reload</code> does
                    automatically.
                </div>
                <group>
                    <field name="package_id"/>
                    <field name="available_model_ids" invisible="1"/>
                    <field name="unowned_count" invisible="1"/>
                    <field name="model_ids" widget="many2many_tags"/>
                </group>
                <div class="text-muted" invisible="not unowned_count">
                    Some of these belong to no package yet — a model made by
                    hand in Settings → Technical has none. Adopting one puts it
                    in the package chosen above.
                </div>
                <group string="Preview" invisible="not preview">
                    <field name="preview" widget="ace" options="{'mode': 'python'}"
                           nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_adopt" type="object" string="Adopt"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="studio_adopt_wizard_action" model="ir.actions.act_window">
        <field name="name">Adopt Existing Model</field>
        <field name="res_model">studio.adopt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="ir_model_view_list_studio" model="ir.ui.view">
        <field name="name">ir.model.list.studio</field>
        <field name="model">ir.model</field>
        <field name="arch" type="xml">
            <list string="Custom Models">
                <field name="name"/>
                <field name="model"/>
                <field name="studio_package_id"/>
                <field name="count" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ir_model_action_studio" model="ir.actions.act_window">
        <field name="name">Custom Models</field>
        <field name="res_model">ir.model</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'manual')]</field>
        <field name="view_id" ref="ir_model_view_list_studio"/>
    </record>

    <record id="ir_model_fields_view_list_studio" model="ir.ui.view">
        <field name="name">ir.model.fields.list.studio</field>
        <field name="model">ir.model.fields</field>
        <field name="arch" type="xml">
            <list string="Custom Fields">
                <field name="model_id"/>
                <field name="name"/>
                <field name="field_description"/>
                <field name="ttype"/>
                <field name="studio_package_id"/>
            </list>
        </field>
    </record>

    <record id="ir_model_fields_action_studio" model="ir.actions.act_window">
        <field name="name">Custom Fields</field>
        <field name="res_model">ir.model.fields</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'manual')]</field>
        <field name="view_id" ref="ir_model_fields_view_list_studio"/>
    </record>
</odoo>
