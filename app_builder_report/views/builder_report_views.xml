<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Odoo's own report form has a "Qweb Views" stat button, which opens the
         template as ir.ui.view records. That is the technical view of it; this
         is the editing one. -->
    <record id="act_report_xml_view_builder" model="ir.ui.view">
        <field name="name">ir.actions.report.form.builder</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_builder_edit"
                    type="object"
                    icon="fa-pencil-square-o"
                    class="oe_stat_button"
                    invisible="report_type not in ['qweb-pdf', 'qweb-html']"
                    groups="app_builder_base.group_builder_user"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Edit Layout</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="act_report_xml_view_tree_builder" model="ir.ui.view">
        <field name="name">ir.actions.report.list.builder</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attachment']" position="after">
                <button
                    name="action_builder_edit"
                    type="object"
                    string="Edit Layout"
                    icon="fa-pencil-square-o"
                    invisible="report_type not in ['qweb-pdf', 'qweb-html']"
                    groups="app_builder_base.group_builder_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
