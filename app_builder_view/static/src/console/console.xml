<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="app_builder_view.StudioConsole">
    <div class="o_studio_console">
        <TopBar model="model" onClose.bind="close" onSwitchView.bind="switchView"
                modelLabel="model.modelLabel"/>

        <div t-if="state.error" class="alert alert-danger m-3" role="alert" t-esc="state.error"/>
        <div t-elif="state.loading" class="o_studio_loading text-muted p-4">
            <i class="fa fa-circle-o-notch fa-spin me-2"/>Opening the view…
        </div>
        <t t-else="">
            <div t-if="state.openedFromMenu"
                 class="alert alert-info alert-dismissible rounded-0 mb-0 py-2 small o_studio_menu_banner"
                 role="status">
                Opened from the Studio menu, so nothing was chosen to edit: this is
                <b t-esc="openedOn"/>. Pick another view of it from the switcher
                above; for another model, open its view and choose
                <i>Edit this view</i> from the cog menu.
                <button type="button" class="btn-close" aria-label="Dismiss"
                        t-on-click="() => state.openedFromMenu = false"/>
            </div>
            <div class="o_studio_console_body">
                <ResizablePanel initialWidth="360" minWidth="300" handleSide="'end'"
                                class="'o_studio_sidebar'">
                    <div class="o_studio_sidebar_inner">
                        <div t-if="packageMissing" class="alert alert-warning rounded-0 mb-0 small" role="alert">
                            No studio package is set up to record changes in, so
                            nothing can be edited yet. Create one under Studio → Packages.
                        </div>
                        <div class="o_studio_sidebar_tabs" role="tablist">
                            <button t-foreach="tabs" t-as="tab" t-key="tab.key" type="button"
                                    role="tab" class="o_studio_sidebar_tab"
                                    t-att-class="{ active: state.tab === tab.key }"
                                    t-att-data-tab="tab.key"
                                    t-att-aria-selected="state.tab === tab.key"
                                    t-on-click="() => state.tab = tab.key">
                                <t t-esc="tab.label"/>
                            </button>
                        </div>
                        <div class="o_studio_sidebar_pane" t-att-data-pane="state.tab">
                            <AddTab t-if="state.tab === 'add'" model="model"/>
                            <ViewTab t-elif="state.tab === 'view'" model="model"/>
                            <PropertiesTab t-else="" model="model"/>
                        </div>
                    </div>
                </ResizablePanel>

                <div class="o_studio_console_canvas">
                    <t t-component="canvasComponent" t-props="canvasProps"/>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
