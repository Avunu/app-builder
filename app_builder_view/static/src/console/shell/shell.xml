<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="app_builder_view.BuilderConsole">
        <div class="o_builder_console">
            <TopBar shell="this.shell" onClose.bind="this.close" />

            <div
                t-if="this.state.error"
                class="alert alert-danger m-3"
                role="alert"
                t-esc="this.state.error"
            />
            <div t-elif="!this.state.ready" class="o_builder_loading text-muted p-4">
            <i class="fa fa-circle-o-notch fa-spin me-2" />Opening the builder…
        </div>
            <t t-else="">
                <div
                    t-if="this.readOnly"
                    class="alert alert-secondary rounded-0 mb-0 py-2 small o_builder_readonly_banner"
                    role="status"
                    t-esc="this.readOnlyNote"
                />
                <!-- Next steps: once, after a flow, and dismissed for good. -->
                <div
                    t-if="this.shell.callout"
                    class="o_builder_callout"
                    role="status"
                    t-att-data-callout="this.shell.callout.key"
                >
                    <div class="d-flex align-items-start gap-2">
                        <i class="fa fa-check-circle o_builder_callout_icon" />
                        <div class="flex-grow-1">
                            <div class="fw-bold" t-esc="this.shell.callout.title" />
                            <ul class="mb-0 ps-3 small">
                                <li
                                    t-foreach="this.shell.callout.lines"
                                    t-as="line"
                                    t-key="line_index"
                                    t-esc="line"
                                />
                            </ul>
                        </div>
                        <button
                            type="button"
                            class="btn btn-link btn-sm p-0 o_builder_callout_close"
                            title="Dismiss"
                            t-on-click="() => this.shell.callout = null"
                        >
                            <i class="fa fa-times" />
                        </button>
                    </div>
                </div>
                <div class="o_builder_console_body" t-att-data-pane="this.shell.pane">
                    <ResizablePanel
                        t-if="this.sidebar"
                        class="'o_builder_sidebar'"
                        t-key="this.shell.pane"
                        initialWidth="this.sidebarWidth"
                        minWidth="300"
                        handleSide="'end'"
                        onResize.bind="this.onSidebarResize"
                    >
                        <div class="o_builder_sidebar_inner">
                            <t t-component="this.sidebar" t-props="this.paneProps" />
                        </div>
                    </ResizablePanel>

                    <div
                        class="o_builder_console_content"
                        t-att-class="{ 'o_builder_console_canvas': this.shell.pane === 'views' }"
                    >
                        <div
                            t-if="this.shell.error"
                            class="alert alert-warning m-3"
                            role="alert"
                            t-esc="this.shell.error"
                        />
                        <div
                            t-elif="this.shell.loading"
                            class="o_builder_loading text-muted p-4"
                        >
                        <i class="fa fa-circle-o-notch fa-spin me-2" />Opening…
                    </div>
                        <t
                            t-elif="this.content"
                            t-component="this.content"
                            t-props="this.paneProps"
                        />
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
