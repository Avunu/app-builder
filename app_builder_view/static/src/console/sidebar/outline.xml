<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="app_builder_view.Outline">
        <div
            class="o_builder_outline"
            t-att-class="{ o_builder_outline_closed: !this.state.open }"
            t-ref="root"
            t-att-style="this.state.open ? 'height:' + this.state.height + 'px' : ''"
        >
            <div class="o_builder_outline_head">
                <button
                    type="button"
                    class="o_builder_outline_toggle"
                    t-att-aria-expanded="this.state.open ? 'true' : 'false'"
                    t-att-title="this.toggleTitle"
                    t-on-click="() => this.toggleOpen()"
                >
                    <i
                        t-att-class="this.state.open ? 'fa fa-caret-down' : 'fa fa-caret-right'"
                        aria-hidden="true"
                    />
                    <span>Outline</span>
                </button>
                <input
                    t-if="this.state.open"
                    class="form-control form-control-sm o_builder_outline_filter"
                    type="search"
                    name="outline_filter"
                    placeholder="Filter…"
                    aria-label="Filter the outline"
                    t-ref="filter"
                    t-att-value="this.state.filter"
                    t-on-input="(ev) => this.state.filter = ev.target.value"
                    t-on-keydown="(ev) => this.onFilterKeyDown(ev)"
                />
            </div>
            <ul
                t-if="this.state.open"
                class="o_builder_outline_list"
                role="tree"
                aria-label="View outline"
                aria-describedby="o_builder_outline_keys"
                t-ref="list"
                t-on-keydown="(ev) => this.onKeyDown(ev)"
            >
                <li
                    class="o_builder_outline_row"
                    t-att-class="{
                    o_builder_outline_selected: entry.token === this.selectedToken,
                    o_builder_outline_hover: entry.token === this.hoverToken,
                    o_builder_outline_hidden: entry.badges.hidden,
                    o_builder_outline_pending: entry.badges.pending,
                    o_builder_outline_fixed: entry.fixed,
                    o_builder_outline_collapsed: entry.hasChildren and !entry.expanded,
                }"
                    t-foreach="this.rows"
                    t-as="entry"
                    t-key="entry.token"
                    role="treeitem"
                    t-att-data-token="entry.token"
                    t-att-data-depth="entry.depth"
                    t-att-data-path="entry.key"
                    t-att-data-kind="entry.node.kind"
                    t-att-data-name="entry.node.name || ''"
                    t-att-aria-level="entry.depth + 1"
                    t-att-aria-expanded="entry.hasChildren ? (entry.expanded ? 'true' : 'false') : undefined"
                    t-att-aria-selected="entry.token === this.selectedToken ? 'true' : 'false'"
                    t-att-tabindex="entry.key === this.focusKey ? 0 : -1"
                    t-att-title="this.model.tagFor(entry.token)"
                    t-att-style="'--o-outline-depth: ' + entry.depth"
                    t-on-click="(ev) => this.onRowClick(entry, ev)"
                    t-on-dblclick="() => this.onRowDblClick(entry)"
                    t-on-mouseenter="() => this.onRowEnter(entry)"
                    t-on-mouseleave="() => this.onRowLeave()"
                    t-on-contextmenu="(ev) => this.onContextMenu(entry, ev)"
                >
                    <button
                        t-if="entry.hasChildren"
                        class="o_builder_outline_caret"
                        type="button"
                        tabindex="-1"
                        t-att-aria-label="this.caretLabel(entry)"
                        t-on-click="(ev) => this.onToggle(entry, ev)"
                    >
                        <i
                            t-att-class="entry.expanded ? 'fa fa-caret-down' : 'fa fa-caret-right'"
                            aria-hidden="true"
                        />
                    </button>
                    <span
                        t-else=""
                        class="o_builder_outline_caret o_builder_outline_leaf"
                    />
                    <i
                        class="o_builder_outline_icon"
                        t-att-class="entry.icon"
                        aria-hidden="true"
                    />
                    <span class="o_builder_outline_label" t-esc="entry.label" />
                    <i
                        t-if="entry.badges.required"
                        class="o_builder_outline_badge fa fa-asterisk"
                        title="Required"
                        role="img"
                        aria-label="Required"
                    />
                    <i
                        t-if="entry.badges.hidden"
                        class="o_builder_outline_badge fa fa-eye-slash"
                        t-att-title="this.hiddenTitle(entry)"
                        role="img"
                        t-att-aria-label="this.hiddenTitle(entry)"
                    />
                    <i
                        t-if="entry.badges.pending"
                        class="o_builder_outline_badge fa fa-clock-o"
                        title="Pending until Apply"
                        role="img"
                        aria-label="Pending until Apply"
                    />
                </li>
                <li
                    t-if="!this.rows.length"
                    class="o_builder_outline_empty text-muted small"
                    role="none"
                >
                    <t t-if="this.state.filter">Nothing matches.</t>
                    <t t-else="">Nothing to show.</t>
                </li>
            </ul>
            <!-- Read out with the tree, shown to nobody: the outline is the
                 way to select, move and remove without a pointer. -->
            <div
                t-if="this.state.open"
                id="o_builder_outline_keys"
                class="visually-hidden"
            >
                Arrow keys move between rows. Enter selects a row on the canvas.
                Alt with an arrow key moves it. Delete removes it. Shift+F10
                opens its menu, which can also move it to another container.
            </div>
            <div
                t-if="this.state.open"
                class="o_builder_outline_divider"
                t-ref="divider"
                title="Drag to resize"
                role="separator"
                aria-orientation="horizontal"
            />
        </div>
    </t>

<t t-name="app_builder_view.OutlineMenu">
        <div
            class="o_builder_outline_menu"
            role="menu"
            aria-label="Outline row actions"
            t-ref="root"
            t-on-keydown="(ev) => this.onKeyDown(ev)"
        >
            <button
                class="dropdown-item"
                t-att-class="{ disabled: item.disabled }"
                t-foreach="this.props.items"
                t-as="item"
                t-key="item.key"
                type="button"
                role="menuitem"
                t-att-disabled="item.disabled"
                t-att-data-item="item.key"
                t-on-click="() => this.pick(item)"
            >
                <i
                    t-if="item.icon"
                    t-att-class="item.icon + ' me-2'"
                    aria-hidden="true"
                />
                <t t-esc="item.label" />
            </button>
            <!-- What a drag reaches, without a pointer: any container that
                 takes the row, picked from a list. -->
            <div
                t-if="this.props.destinations and this.props.destinations.length"
                class="o_builder_outline_move_to"
                role="none"
            >
                <select
                    class="form-select form-select-sm"
                    name="move_to"
                    aria-label="Move to…"
                    t-on-change="(ev) => this.onMoveTo(ev)"
                >
                    <option value="">Move to…</option>
                    <option
                        t-foreach="this.props.destinations"
                        t-as="place"
                        t-key="place.token"
                        t-att-value="place.token"
                        t-esc="place.label"
                    />
                </select>
            </div>
        </div>
    </t>

</templates>
