<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="app_builder_view.StudioEditor">
    <div class="o_studio_editor d-flex flex-column h-100">
        <div class="o_studio_topbar d-flex align-items-center gap-2 p-2 border-bottom">
            <span class="fw-bold">Studio</span>
            <input type="text" class="form-control form-control-sm w-auto"
                   placeholder="model, e.g. res.partner"
                   t-att-value="state.resModel"
                   t-on-change="onModelChange"/>
            <select class="form-select form-select-sm w-auto"
                    t-on-change="onViewChange"
                    t-if="state.views.length">
                <t t-foreach="state.views" t-as="v" t-key="v.id">
                    <option t-att-value="v.id" t-att-selected="v.id === state.viewId">
                        <t t-esc="v.name"/> (<t t-esc="v.type"/>)
                    </option>
                </t>
            </select>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="text-muted small">write into</span>
                <select class="form-select form-select-sm w-auto" t-on-change="onPackageChange">
                    <t t-foreach="state.packages" t-as="p" t-key="p.id">
                        <option t-att-value="p.id"
                                t-att-selected="p.id === state.packageId"
                                t-att-disabled="!p.writable">
                            <t t-esc="p.name"/>
                            <t t-if="!p.writable"> (read-only)</t>
                        </option>
                    </t>
                </select>
                <button class="btn btn-sm btn-secondary" t-on-click="openPackage">
                    Open package
                </button>
            </div>
        </div>

        <div class="d-flex flex-grow-1 overflow-hidden">
            <div class="o_studio_sidebar border-end p-2 overflow-auto">
                <h6 class="mt-1">Add a field</h6>
                <div class="list-group list-group-flush small">
                    <t t-foreach="state.fields" t-as="f" t-key="f.name">
                        <button class="list-group-item list-group-item-action py-1"
                                t-att-class="{ active: state.selectedField === f.name }"
                                t-on-click="() => this.selectField(f)">
                            <div class="d-flex justify-content-between">
                                <span t-esc="f.string"/>
                                <span class="text-muted" t-esc="f.type"/>
                            </div>
                            <div class="text-muted font-monospace" t-esc="f.name"/>
                        </button>
                    </t>
                    <div t-if="!state.fields.length" class="text-muted p-2">
                        Every field of this model is already in the view.
                    </div>
                </div>

                <h6 class="mt-3">Target</h6>
                <div class="o_studio_nodes border rounded small">
                    <t t-foreach="state.nodes" t-as="n" t-key="n.xpath + '_' + n_index">
                        <button class="o_studio_node d-block w-100 text-start border-0 bg-transparent py-0"
                                t-att-class="{ 'fw-bold text-primary': n.xpath === state.targetXpath }"
                                t-att-style="nodeIndent(n)"
                                t-on-click="() => this.selectNode(n)">
                            <span t-esc="n.tag"/>
                            <span t-if="n.label" class="text-muted"> · <t t-esc="n.label"/></span>
                        </button>
                    </t>
                </div>
                <label class="form-label small mb-0 mt-2">xpath</label>
                <input type="text" class="form-control form-control-sm font-monospace"
                       t-model="state.targetXpath"/>
                <label class="form-label small mb-0 mt-2">position</label>
                <select class="form-select form-select-sm" t-model="state.position">
                    <option value="inside">inside</option>
                    <option value="after">after</option>
                    <option value="before">before</option>
                    <option value="replace">replace</option>
                </select>

                <div class="d-grid gap-2 mt-3">
                    <button class="btn btn-primary btn-sm"
                            t-att-disabled="state.busy"
                            t-on-click="addSelectedField">
                        Add field here
                    </button>
                    <button class="btn btn-outline-danger btn-sm"
                            t-att-disabled="state.busy"
                            t-on-click="removeNode">
                        Remove node at xpath
                    </button>
                </div>

                <p class="text-muted small mt-3 mb-0">
                    Every change is written as an inheriting view at priority 99,
                    then saved into the selected package as source you can diff
                    and commit.
                </p>
            </div>

            <div class="o_studio_preview flex-grow-1 overflow-auto p-2">
                <t t-if="state.resModel and state.viewId">
                    <View t-key="state.previewKey"
                          resModel="state.resModel"
                          type="viewType"
                          viewId="state.viewId"/>
                </t>
                <div t-else="" class="text-muted p-4">
                    Enter a model name above to start editing its views.
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
