<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="app_builder_view.StudioViewEditor">
    <div class="o_studio_view_editor d-flex flex-column h-100">

        <div class="o_studio_view_editor_bar d-flex align-items-center gap-2 px-3 py-2 border-bottom">
            <span class="fw-bold" t-esc="view.model"/>
            <span class="badge text-bg-secondary" t-esc="view.type"/>
            <small class="text-muted" t-esc="view.name"/>
            <span t-if="state.context and !state.context.owned"
                  class="badge text-bg-info">inheriting view</span>
            <div class="flex-grow-1"/>
            <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin text-muted"/>
            <button class="btn btn-secondary btn-sm" t-att-disabled="!lastEdit"
                    t-att-title="lastEdit and ('Undo: ' + lastEdit.summary)"
                    t-on-click="() => this.onUndo()">
                <i class="fa fa-undo me-1"/>Undo
            </button>
            <button class="btn btn-secondary btn-sm" t-on-click="() => this.selectRoot()">
                Select the view itself
            </button>
        </div>

        <div t-if="state.context and !packageId"
             class="alert alert-warning rounded-0 mb-0" role="alert">
            No studio package is set up to record changes in, so nothing can be
            edited yet. Create one under Studio → Packages.
        </div>

        <div class="d-flex flex-grow-1 overflow-hidden">
            <ResizablePanel initialWidth="420" minWidth="320" handleSide="'end'"
                            class="'o_studio_view_editor_side border-end'">
                <div class="d-flex flex-column h-100 overflow-auto p-2">

                    <div class="alert alert-light small" role="alert" t-esc="ownershipNote"/>

                    <t t-if="isReport">
                        <div class="text-muted small mb-2">
                            Click a value in the document to select it. The prose
                            around it is not something the builder put there, so
                            it is edited as source.
                        </div>
                        <div t-if="state.target and state.target.found"
                             class="alert alert-light small" role="alert">
                            Selected <code t-esc="state.target.expression"/> —
                            what you add next goes just after it.
                        </div>
                        <div t-if="state.report.anchorReason and !state.target"
                             class="alert alert-warning small" role="alert"
                             t-esc="state.report.anchorReason"/>

                        <div class="mt-3 pt-2 border-top px-1">
                            <div class="fw-bold mb-1">Place a value</div>
                            <select class="form-select form-select-sm mb-1"
                                    name="report_field"
                                    t-on-change="(ev) => state.reportField = ev.target.value">
                                <option value="">Choose a field…</option>
                                <option t-foreach="state.report.values or []" t-as="f"
                                        t-key="f.name" t-att-value="f.name"
                                        t-esc="f.string"/>
                            </select>
                            <input type="text" class="form-control form-control-sm mb-1"
                                   name="report_label" placeholder="Label (optional)"
                                   t-att-value="state.reportLabel"
                                   t-on-input="(ev) => state.reportLabel = ev.target.value"/>
                            <button class="btn btn-sm btn-primary w-100"
                                    name="place_report_field"
                                    t-att-disabled="state.busy or !state.reportField"
                                    t-on-click="() => this.placeReportField()">
                                Place
                            </button>
                        </div>

                        <div class="mt-3 pt-2 border-top px-1">
                            <div class="fw-bold mb-1">Print a table</div>
                            <select class="form-select form-select-sm mb-1"
                                    name="report_list"
                                    t-on-change="(ev) => { state.reportList = ev.target.value; state.reportColumns = []; }">
                                <option value="">Choose a list…</option>
                                <option t-foreach="state.report.lists or []" t-as="f"
                                        t-key="f.name" t-att-value="f.name"
                                        t-esc="f.string"/>
                            </select>
                            <div t-if="state.reportList" class="mb-1">
                                <div class="text-muted small">Columns, in order:</div>
                                <div t-foreach="reportColumnChoices" t-as="col"
                                     t-key="col.name" class="form-check form-check-sm">
                                    <input t-att-id="'rc_' + col.name" class="form-check-input"
                                           type="checkbox"
                                           t-att-checked="state.reportColumns.includes(col.name)"
                                           t-on-change="() => this.toggleReportColumn(col.name)"/>
                                    <label class="form-check-label small"
                                           t-att-for="'rc_' + col.name" t-esc="col.string"/>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-primary w-100"
                                    name="place_report_table"
                                    t-att-disabled="state.busy or !state.reportColumns.length"
                                    t-on-click="() => this.placeReportTable()">
                                Add table
                            </button>
                        </div>
                    </t>

                    <div t-if="!state.target and !isSearch and !isReport" class="text-muted p-2">
                        Click anything in the view to edit it — a column heading,
                        a value, or empty space for the view's own settings.
                    </div>

                    <t t-if="isSearch">
                        <div class="text-muted small mb-2">
                            A search view has no display of its own — it fills the
                            search bar and menus of the list below. So it is edited
                            as the three lists it is.
                        </div>

                        <div class="fw-bold mb-1">Searchable fields</div>
                        <div t-foreach="state.search.fields" t-as="entry"
                             t-key="entry.name"
                             class="d-flex align-items-center gap-2 mb-1">
                            <span class="flex-grow-1 text-truncate" t-esc="entry.name"/>
                            <button class="btn btn-link btn-sm text-danger p-0"
                                    t-on-click="() => this.removeSearchElement('field', entry.name)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <select class="form-select form-select-sm mb-3"
                                t-on-change="(ev) => this.onAddSearchField(ev)">
                            <option value="">Add a searchable field…</option>
                            <option t-foreach="searchFieldChoices" t-as="field"
                                    t-key="field.name" t-att-value="field.name">
                                <t t-esc="field.string"/> (<t t-esc="field.name"/>)
                            </option>
                        </select>

                        <div class="fw-bold mb-1">Filters</div>
                        <div t-foreach="state.search.filters" t-as="entry"
                             t-key="entry.name"
                             class="d-flex align-items-center gap-2 mb-1">
                            <span class="flex-grow-1 text-truncate" t-esc="entry.string"/>
                            <button class="btn btn-link btn-sm text-danger p-0"
                                    t-on-click="() => this.removeSearchElement('filter', entry.name)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="d-flex gap-1 mb-3">
                            <select class="form-select form-select-sm"
                                    t-on-change="(ev) => this.state.filterField = ev.target.value">
                                <option value="">Field…</option>
                                <option t-foreach="state.context.fields" t-as="field"
                                        t-key="field.name" t-att-value="field.name"
                                        t-esc="field.string"/>
                            </select>
                            <select class="form-select form-select-sm"
                                    t-on-change="(ev) => this.state.filterCondition = ev.target.value">
                                <option value="set">is set</option>
                                <option value="not_set">is not set</option>
                                <option value="true">is true</option>
                                <option value="false">is false</option>
                            </select>
                            <button class="btn btn-light btn-sm"
                                    t-att-disabled="!state.filterField"
                                    t-on-click="() => this.onAddFilter()">Add</button>
                        </div>

                        <div class="fw-bold mb-1">Group by</div>
                        <div t-foreach="state.search.group_bys" t-as="entry"
                             t-key="entry.name"
                             class="d-flex align-items-center gap-2 mb-1">
                            <span class="flex-grow-1 text-truncate" t-esc="entry.string"/>
                            <button class="btn btn-link btn-sm text-danger p-0"
                                    t-on-click="() => this.removeSearchElement('filter', entry.name)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <select class="form-select form-select-sm mb-2"
                                t-on-change="(ev) => this.onAddGroupBy(ev)">
                            <option value="">Add a group-by…</option>
                            <option t-foreach="groupByChoices" t-as="field"
                                    t-key="field.name" t-att-value="field.name">
                                <t t-esc="field.string"/>
                            </option>
                        </select>

                        <div class="text-muted small">
                            Anything more intricate — a domain with several terms —
                            belongs in the source, where it can be read.
                        </div>
                    </t>

                    <div t-if="state.message" class="alert alert-info small"
                         role="alert" t-esc="state.message"/>

                    <t t-foreach="panels" t-as="panel" t-key="panel.id">
                        <div class="fw-bold px-1 mb-1" t-esc="panel.title"/>
                        <div t-foreach="panel.rows" t-as="row" t-key="row.key"
                             class="mb-2 px-1">

                            <t t-if="row.type === 'toggle'">
                                <label class="d-flex align-items-center gap-2 mb-0">
                                    <input type="checkbox" class="form-check-input mt-0"
                                           t-att-checked="row.value"
                                           t-on-change="(ev) => this.onToggle(row, ev)"/>
                                    <span t-esc="row.label"/>
                                </label>
                            </t>

                            <t t-else="">
                                <label class="form-label small text-muted mb-0"
                                       t-esc="row.label"/>
                                <select t-if="row.type === 'select'"
                                        class="form-select form-select-sm"
                                        t-on-change="(ev) => this.onInput(row, ev)">
                                    <option t-foreach="row.choices" t-as="choice"
                                            t-key="choice[0]" t-att-value="choice[0]"
                                            t-att-selected="choice[0] === row.value"
                                            t-esc="choice[1]"/>
                                </select>
                                <!-- Group visibility is a list of xmlids, because
                                     that is what the arch carries and what still
                                     resolves in the next database. -->
                                <select t-elif="row.type === 'groups'" class="form-select form-select-sm"
                                        multiple="multiple"
                                        size="6"
                                        t-on-change="(ev) => this.onMultiSelect(row, ev)">
                                    <option t-foreach="groupChoices" t-as="group"
                                            t-key="group.xmlid" t-att-value="group.xmlid"
                                            t-att-selected="row.value.includes(group.xmlid)"
                                            t-esc="group.name"/>
                                </select>
                                <!-- A Python expression over the record, not a
                                     domain: `attrs` went away in 17.0 and these
                                     attributes are evaluated, not matched. -->
                                <input t-elif="row.type === 'condition'" class="form-control form-control-sm font-monospace"
                                       type="text"
                                       t-att-value="row.value"
                                       placeholder="state == 'draft'"
                                       t-on-change="(ev) => this.onInput(row, ev)"/>
                                <input t-else="" class="form-control form-control-sm"
                                       type="text"
                                       t-att-value="row.value"
                                       t-att-placeholder="row.placeholder"
                                       t-on-change="(ev) => this.onInput(row, ev)"/>
                            </t>

                            <small t-if="row.help" class="text-muted d-block"
                                   t-esc="row.help"/>
                        </div>

                        <!-- Removing takes the node out of the rendered view via
                             position="replace"; hiding leaves it there and still
                             loading, which is usually what somebody means. Both
                             are offered, side by side, so the difference is a
                             choice rather than a discovery. -->
                        <div t-if="canRemoveSelection" class="px-1 mb-3">
                            <button class="btn btn-outline-danger btn-sm w-100"
                                    t-att-disabled="state.busy or !packageId"
                                    t-on-click="() => this.removeSelected()">
                                Remove from view
                            </button>
                            <small class="text-muted d-block">
                                Takes it off this screen only. To keep it loading
                                but out of sight, use Hidden above.
                            </small>
                        </div>
                    </t>

                    <t t-if="!isSearch and !isReport">
                        <div t-if="state.fieldPlan" class="mt-3 pt-2 border-top px-1">
                            <div class="fw-bold mb-1">New field</div>
                            <div t-if="!state.fieldPlan.can_create"
                                 class="text-muted small mb-1">
                                <span t-esc="state.fieldPlan.reason"/>
                                <button t-if="state.fieldPlan.handoff"
                                        class="btn btn-sm btn-secondary w-100 mt-1"
                                        name="open_composer"
                                        t-on-click="() => this.openComposer()">
                                    Open the composer
                                </button>
                            </div>
                            <t t-else="">
                                <div class="text-muted small mb-1" t-esc="anchorNote"/>
                                <input type="text" name="new_field_label"
                                       class="form-control form-control-sm mb-1"
                                       placeholder="Label, e.g. Delivery date"
                                       t-att-value="state.newField.field_description"
                                       t-on-input="(ev) => state.newField.field_description = ev.target.value"/>
                                <select class="form-select form-select-sm mb-1"
                                        name="new_field_type"
                                        t-on-change="(ev) => state.newField.ttype = ev.target.value">
                                    <option t-foreach="state.fieldTypes" t-as="t"
                                            t-key="t.value" t-att-value="t.value"
                                            t-esc="t.label"/>
                                </select>
                                <input t-if="state.newField.ttype === 'many2one'"
                                       class="form-control form-control-sm mb-1" type="text"
                                       name="new_field_relation"
                                       placeholder="Model to link to, e.g. res.partner"
                                       t-att-value="state.newField.relation"
                                       t-on-input="(ev) => state.newField.relation = ev.target.value"/>
                                <button class="btn btn-sm btn-primary w-100"
                                        name="create_field"
                                        t-att-disabled="state.busy or !state.newField.field_description"
                                        t-on-click="() => this.createField()">
                                    Create and place it
                                </button>
                            </t>
                        </div>

                        <div class="mt-3 pt-2 border-top px-1">
                            <div class="fw-bold mb-1">Add to this view</div>
                            <div class="text-muted small mb-2" t-esc="anchorNote"/>

                            <input type="search" class="form-control form-control-sm mb-1"
                                   placeholder="Search fields…"
                                   t-att-value="state.paletteFilter"
                                   t-on-input="(ev) => this.state.paletteFilter = ev.target.value"/>
                            <div class="app-builder-palette mb-2">
                                <button t-foreach="paletteChoices" t-as="field"
                                        t-key="field.name"
                                        class="btn btn-light btn-sm w-100 text-start mb-1"
                                        t-att-disabled="state.busy or !packageId"
                                        t-att-title="field.name"
                                        t-on-click="() => this.addField(field.name)">
                                    <t t-esc="field.string"/>
                                    <span class="text-muted small ms-1" t-esc="field.name"/>
                                </button>
                                <div t-if="!paletteChoices.length" class="text-muted small">
                                    Every field of this model is already on the view.
                                </div>
                            </div>

                            <t t-if="view.type === 'form'">
                                <div class="d-flex gap-1 mb-2">
                                    <button class="btn btn-light btn-sm flex-grow-1"
                                            t-att-disabled="state.busy or !packageId"
                                            t-on-click="() => this.addContainer('group')">
                                        Add a group
                                    </button>
                                    <button class="btn btn-light btn-sm flex-grow-1"
                                            t-att-disabled="state.busy or !packageId"
                                            t-on-click="() => this.addContainer('page')">
                                        Add a tab
                                    </button>
                                </div>
                            </t>

                            <!-- Server actions only. Naming a Python method, as
                                 Odoo Studio allows, writes a call to something
                                 that may not exist and saves happily; the failure
                                 arrives later, for whoever presses the button. -->
                            <div t-if="state.serverActions.length" class="mb-2">
                                <label class="form-label small text-muted mb-0">Add a button</label>
                                <input type="text" class="form-control form-control-sm mb-1"
                                       placeholder="Label"
                                       t-att-value="state.newButton.string"
                                       t-on-input="(ev) => this.state.newButton.string = ev.target.value"/>
                                <select class="form-select form-select-sm mb-1"
                                        t-on-change="(ev) => this.state.newButton.action_id = ev.target.value">
                                    <option value="">Runs which action?</option>
                                    <option t-foreach="state.serverActions" t-as="action"
                                            t-key="action.id" t-att-value="action.id"
                                            t-esc="action.name"/>
                                </select>
                                <button class="btn btn-light btn-sm w-100"
                                        t-att-disabled="state.busy or !packageId or !state.newButton.action_id"
                                        t-on-click="() => this.addButton()">
                                    Add the button
                                </button>
                            </div>
                        </div>
                    </t>

                    <div t-if="state.addable.length" class="mt-3 pt-2 border-top px-1">
                        <div class="fw-bold mb-1">Add a view</div>
                        <div t-foreach="state.addable" t-as="entry" t-key="entry.type"
                             class="mb-1">
                            <button class="btn btn-light btn-sm w-100 text-start"
                                    t-att-disabled="!entry.enabled or !packageId"
                                    t-att-title="entry.reason || entry.label"
                                    t-on-click="() => this.onAddView(entry)">
                                <i t-att-class="'me-1 ' + (entry.icon || 'fa fa-plus')"/>
                                <t t-esc="entry.label || entry.type"/>
                            </button>
                            <small t-if="entry.reason" class="text-muted d-block"
                                   t-esc="entry.reason"/>
                        </div>
                    </div>

                    <div t-if="state.history.length" class="mt-3 pt-2 border-top px-1">
                        <div class="fw-bold mb-1">Recent changes</div>
                        <div t-foreach="state.history" t-as="entry" t-key="entry.id"
                             class="small text-muted" t-esc="entry.summary"/>
                    </div>

                    <div class="text-muted small mt-3 px-1">
                        Changes are saved as you make them and are visible to
                        everyone straight away — a view is data, so there is
                        nothing to reload.
                    </div>
                </div>
            </ResizablePanel>

            <div class="flex-grow-1 overflow-auto o_studio_view_editor_preview"
                 t-ref="preview">
                <!-- A report is a template: the client has no qweb view type,
                     so the preview is the report's own rendered output. -->
                <div t-if="isReport" class="o_studio_report_preview p-3">
                    <div t-if="state.report.reason" class="alert alert-info"
                         role="alert" t-esc="state.report.reason"/>
                    <div t-else="" t-out="state.report.html"/>
                </div>
                <View t-if="!isReport and preview.view_id" t-key="state.previewKey"
                      resModel="view.model" type="preview.type"
                      viewId="preview.view_id"
                      searchViewId="preview.search_view_id"/>
                <div t-if="state.context and !isReport and !preview.view_id"
                     class="alert alert-info m-3" role="alert">
                    This search view has no list to show it in, so there is
                    nothing to preview — the panel on the left is still the
                    editor for it.
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
