<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="app_builder_view.StudioViewEditor">
    <div class="o_studio_view_editor d-flex flex-column h-100">

        <div class="o_studio_view_editor_bar d-flex align-items-center gap-2 px-3 py-2 border-bottom">
            <span class="fw-bold" t-esc="view.model"/>
            <span class="badge text-bg-secondary" t-esc="view.type"/>
            <small class="text-muted" t-esc="view.name"/>
            <span t-if="state.context and !state.context.owned"
                  class="badge text-bg-info">inheriting view</span>
            <div class="flex-grow-1"/>
            <span t-if="state.busy" class="fa fa-circle-o-notch fa-spin text-muted"/>
            <button class="btn btn-secondary btn-sm" t-att-disabled="!lastEdit"
                    t-att-title="lastEdit and ('Undo: ' + lastEdit.summary)"
                    t-on-click="() => this.onUndo()">
                <i class="fa fa-undo me-1"/>Undo
            </button>
            <button class="btn btn-secondary btn-sm" t-on-click="() => this.selectRoot()">
                Select the view itself
            </button>
        </div>

        <div t-if="state.context and !packageId"
             class="alert alert-warning rounded-0 mb-0" role="alert">
            No studio package is set up to record changes in, so nothing can be
            edited yet. Create one under Studio → Packages.
        </div>

        <div class="d-flex flex-grow-1 overflow-hidden">
            <ResizablePanel initialWidth="420" minWidth="320" handleSide="'end'"
                            class="'o_studio_view_editor_side border-end'">
                <div class="d-flex flex-column h-100 overflow-auto p-2">

                    <div class="alert alert-light small" role="alert" t-esc="ownershipNote"/>

                    <div t-if="!state.target and !isSearch" class="text-muted p-2">
                        Click anything in the view to edit it — a column heading,
                        a value, or empty space for the view's own settings.
                    </div>

                    <t t-if="isSearch">
                        <div class="text-muted small mb-2">
                            A search view has no display of its own — it fills the
                            search bar and menus of the list below. So it is edited
                            as the three lists it is.
                        </div>

                        <div class="fw-bold mb-1">Searchable fields</div>
                        <div t-foreach="state.search.fields" t-as="entry"
                             t-key="entry.name"
                             class="d-flex align-items-center gap-2 mb-1">
                            <span class="flex-grow-1 text-truncate" t-esc="entry.name"/>
                            <button class="btn btn-link btn-sm text-danger p-0"
                                    t-on-click="() => this.removeSearchElement('field', entry.name)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <select class="form-select form-select-sm mb-3"
                                t-on-change="(ev) => this.onAddSearchField(ev)">
                            <option value="">Add a searchable field…</option>
                            <option t-foreach="searchFieldChoices" t-as="field"
                                    t-key="field.name" t-att-value="field.name">
                                <t t-esc="field.string"/> (<t t-esc="field.name"/>)
                            </option>
                        </select>

                        <div class="fw-bold mb-1">Filters</div>
                        <div t-foreach="state.search.filters" t-as="entry"
                             t-key="entry.name"
                             class="d-flex align-items-center gap-2 mb-1">
                            <span class="flex-grow-1 text-truncate" t-esc="entry.string"/>
                            <button class="btn btn-link btn-sm text-danger p-0"
                                    t-on-click="() => this.removeSearchElement('filter', entry.name)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="d-flex gap-1 mb-3">
                            <select class="form-select form-select-sm"
                                    t-on-change="(ev) => this.state.filterField = ev.target.value">
                                <option value="">Field…</option>
                                <option t-foreach="state.context.fields" t-as="field"
                                        t-key="field.name" t-att-value="field.name"
                                        t-esc="field.string"/>
                            </select>
                            <select class="form-select form-select-sm"
                                    t-on-change="(ev) => this.state.filterCondition = ev.target.value">
                                <option value="set">is set</option>
                                <option value="not_set">is not set</option>
                                <option value="true">is true</option>
                                <option value="false">is false</option>
                            </select>
                            <button class="btn btn-light btn-sm"
                                    t-att-disabled="!state.filterField"
                                    t-on-click="() => this.onAddFilter()">Add</button>
                        </div>

                        <div class="fw-bold mb-1">Group by</div>
                        <div t-foreach="state.search.group_bys" t-as="entry"
                             t-key="entry.name"
                             class="d-flex align-items-center gap-2 mb-1">
                            <span class="flex-grow-1 text-truncate" t-esc="entry.string"/>
                            <button class="btn btn-link btn-sm text-danger p-0"
                                    t-on-click="() => this.removeSearchElement('filter', entry.name)">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <select class="form-select form-select-sm mb-2"
                                t-on-change="(ev) => this.onAddGroupBy(ev)">
                            <option value="">Add a group-by…</option>
                            <option t-foreach="groupByChoices" t-as="field"
                                    t-key="field.name" t-att-value="field.name">
                                <t t-esc="field.string"/>
                            </option>
                        </select>

                        <div class="text-muted small">
                            Anything more intricate — a domain with several terms —
                            belongs in the source, where it can be read.
                        </div>
                    </t>

                    <div t-if="state.message" class="alert alert-info small"
                         role="alert" t-esc="state.message"/>

                    <t t-foreach="panels" t-as="panel" t-key="panel.id">
                        <div class="fw-bold px-1 mb-1" t-esc="panel.title"/>
                        <div t-foreach="panel.rows" t-as="row" t-key="row.key"
                             class="mb-2 px-1">

                            <t t-if="row.type === 'toggle'">
                                <label class="d-flex align-items-center gap-2 mb-0">
                                    <input type="checkbox" class="form-check-input mt-0"
                                           t-att-checked="row.value"
                                           t-on-change="(ev) => this.onToggle(row, ev)"/>
                                    <span t-esc="row.label"/>
                                </label>
                            </t>

                            <t t-else="">
                                <label class="form-label small text-muted mb-0"
                                       t-esc="row.label"/>
                                <select t-if="row.type === 'select'"
                                        class="form-select form-select-sm"
                                        t-on-change="(ev) => this.onInput(row, ev)">
                                    <option t-foreach="row.choices" t-as="choice"
                                            t-key="choice[0]" t-att-value="choice[0]"
                                            t-att-selected="choice[0] === row.value"
                                            t-esc="choice[1]"/>
                                </select>
                                <!-- Group visibility is a list of xmlids, because
                                     that is what the arch carries and what still
                                     resolves in the next database. -->
                                <select t-elif="row.type === 'groups'" multiple="multiple"
                                        class="form-select form-select-sm"
                                        size="6"
                                        t-on-change="(ev) => this.onMultiSelect(row, ev)">
                                    <option t-foreach="groupChoices" t-as="group"
                                            t-key="group.xmlid" t-att-value="group.xmlid"
                                            t-att-selected="row.value.includes(group.xmlid)"
                                            t-esc="group.name"/>
                                </select>
                                <!-- A Python expression over the record, not a
                                     domain: `attrs` went away in 17.0 and these
                                     attributes are evaluated, not matched. -->
                                <input t-elif="row.type === 'condition'" type="text"
                                       class="form-control form-control-sm font-monospace"
                                       t-att-value="row.value"
                                       placeholder="state == 'draft'"
                                       t-on-change="(ev) => this.onInput(row, ev)"/>
                                <input t-else="" type="text"
                                       class="form-control form-control-sm"
                                       t-att-value="row.value"
                                       t-att-placeholder="row.placeholder"
                                       t-on-change="(ev) => this.onInput(row, ev)"/>
                            </t>

                            <small t-if="row.help" class="text-muted d-block"
                                   t-esc="row.help"/>
                        </div>
                    </t>

                    <div t-if="state.addable.length" class="mt-3 pt-2 border-top px-1">
                        <div class="fw-bold mb-1">Add a view</div>
                        <div t-foreach="state.addable" t-as="entry" t-key="entry.type"
                             class="mb-1">
                            <button class="btn btn-light btn-sm w-100 text-start"
                                    t-att-disabled="!entry.enabled or !packageId"
                                    t-att-title="entry.reason"
                                    t-on-click="() => this.onAddView(entry)">
                                <i class="fa fa-plus me-1"/><t t-esc="entry.type"/>
                            </button>
                            <small t-if="entry.reason" class="text-muted d-block"
                                   t-esc="entry.reason"/>
                        </div>
                    </div>

                    <div t-if="state.history.length" class="mt-3 pt-2 border-top px-1">
                        <div class="fw-bold mb-1">Recent changes</div>
                        <div t-foreach="state.history" t-as="entry" t-key="entry.id"
                             class="small text-muted" t-esc="entry.summary"/>
                    </div>

                    <div class="text-muted small mt-3 px-1">
                        Changes are saved as you make them and are visible to
                        everyone straight away — a view is data, so there is
                        nothing to reload.
                    </div>
                </div>
            </ResizablePanel>

            <div class="flex-grow-1 overflow-auto o_studio_view_editor_preview"
                 t-ref="preview">
                <View t-if="preview.view_id" t-key="state.previewKey"
                      resModel="view.model" type="preview.type"
                      viewId="preview.view_id"
                      searchViewId="preview.search_view_id"/>
                <div t-if="state.context and !preview.view_id"
                     class="alert alert-info m-3" role="alert">
                    This search view has no list to show it in, so there is
                    nothing to preview — the panel on the left is still the
                    editor for it.
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
