{
  "name": "app-builder-tools",
  "private": true,
  "version": "0.0.0",
  "description": "The locked lint tools (odoo-nix's js-xml module) and the type checkers (see TYPING.md). Each addon's own package.json compiles its TypeScript.",
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "lint:ts": "eslint -c eslint.typescript.config.mjs '**/*.ts'"
  },
  "devDependencies": {
    "@odoo/owl": "2.8.3",
    "@prettier/plugin-xml": "3.4.1",
    "eslint": "9.12.0",
    "eslint-plugin-jsdoc": "50.3.1",
    "globals": "16.0.0",
    "prettier": "3.3.3",
    "pyright": "^1.1.389",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
