{
  // For the OCA CI container only (ghcr.io/oca/oca-ci/py3.10-odoo18.0 and
  // its OCB sibling), not local dev -- see pyrightconfig.json for that.
  // `test.yml`'s `typecheck` job runs `scripts/ci_addons_mirror.py` first,
  // then `npx pyright -p pyrightconfig.ci.json`.
  //
  // Extends the local config so the two check the SAME rules -- every
  // rule, the `tools/` strict `executionEnvironments` included. This file
  // was once a standalone copy, and it silently lost those environments:
  // CI passed a `tools/` file that local dev rejected with four strict-
  // mode errors. Only the three path keys differ, and `extends` replaces
  // an array/string key outright, which is exactly what they need
  // (confirmed: the inherited execution environments resolve imports
  // through THIS file's `extraPaths`, not the local one's). tsconfig.ci
  // .json stays standalone for the opposite reason -- there `extends`
  // would replace `compilerOptions.paths` and drop every `@app_builder_*`
  // alias (TYPING.md, "CI: the OCA container's real layout").
  //
  // What the paths come from, read from the container's own Dockerfile
  // and bin scripts, not assumed:
  //
  //  - Odoo core (`/opt/odoo`) is `pip install -e`'d straight into the
  //    venv, so `odoo`/`odoo.addons.web` resolve from the venv alone.
  //  - Every OCA addon this repo depends on gets pip-installed for real as
  //    a side effect of `oca_install_addons` resolving this repo's own
  //    addons' dependency metadata.
  //  - What neither covers is THIS repo's own addons resolving as
  //    `odoo.addons.<name>` from each other: the container only tells
  //    Odoo's *runtime* loader about `$ADDONS_DIR` (a plain
  //    `addons_path=...,.` line), which a standalone pyright run never
  //    executes. `scripts/ci_addons_mirror.py` builds the mirror below for
  //    exactly that gap.
  "extends": "./pyrightconfig.json",

  "extraPaths": ["/tmp/app-builder-addons-mirror"],

  // The container's venv (Dockerfile: `python$python_version -m venv
  // /opt/odoo-venv`); absolute, so venvPath/venv aren't relative to this
  // file the way local dev's are.
  "venvPath": "/opt",
  "venv": "odoo-venv"
}
