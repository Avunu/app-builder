{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@app_builder_base/*": ["app_builder_base/static/src/*"],
      "@app_builder_model/*": ["app_builder_model/static/src/*"],
      "@app_builder_view/*": ["app_builder_view/static/src/*"],
      "@app_builder_ui/*": ["app_builder_ui/static/src/*"],
      "@app_builder_report/*": ["app_builder_report/static/src/*"],
      "@app_builder_approval/*": ["app_builder_approval/static/src/*"],
      "@web/*": ["./.odoo-nix/odoo/addons/web/static/src/*"],
      "@html_editor/*": ["./.odoo-nix/odoo/addons/html_editor/static/src/*"],
      "@web_tour/*": ["./.odoo-nix/odoo/addons/web_tour/static/src/*"],
      "@mail/*": ["./.odoo-nix/odoo/addons/mail/static/src/*"]
    }
  },
  // `.odoo-nix/odoo` is OCB, the store path the addons-mode dev shell links
  // there (flake.nix), so tsc needs the shell. See TYPING.md.
  "include": [
    "*/static/src/**/*",
    "*/static/tests/**/*",
    "*/types/**/*.d.ts",
    // Cherry-picked, not a blanket `@types/**/*.d.ts` glob. No owl.d.ts:
    // @odoo/owl is a real npm dependency (package.json: types ->
    // dist/types/owl.d.ts) that resolves on its own, and OCB's own
    // ambient re-export of it does not survive moduleResolution: bundler
    // resolving its wildcard `exports` subpath -- ends up empty,
    // shadowing the real one for nothing (confirmed with a probe import;
    // "Module has no exported member" until owl.d.ts was dropped here).
    //
    // Odoo's `services.d.ts` and most of `@types/registries/*.d.ts`
    // *import concrete service/registry implementation modules* to derive
    // their types (`import { commandService } from "@web/core/commands/..."`),
    // which pulls those real .js files into the program -- and a couple
    // of them opt into per-file checking with `//@ts-check`, overriding
    // `checkJs: false` and surfacing errors in vendored code we do not
    // own (scripts/typecheck.mjs filters those out; see its own
    // docstring). Included anyway where the accuracy is worth the extra
    // vendor noise -- `views_registry.d.ts` for `ViewsRegistryItemShape`
    // (`canvas_views.ts` derives real view descriptors, not a shape
    // reinvented here), `fields_registry.d.ts` for `FieldsRegistryItemShape`
    // (`options.ts`'s `supportedTypes` check against `registry.category("fields")`),
    // and `fields.d.ts` for the field-definition types both of those need.
    // `services`/`useService` still gets its own narrow, hand-written
    // facade instead (Phase 2c, console/odoo.ts) rather than pulling in
    // `services.d.ts` itself -- that one's cascade is the webclient's
    // entire service registry, not one view-descriptor shape.
    "./.odoo-nix/odoo/addons/web/static/src/@types/odoo.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/hoot.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/libs.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/qunit.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/fields.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/registry.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/registries/services_registry.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/registries/views_registry.d.ts",
    "./.odoo-nix/odoo/addons/web/static/src/@types/registries/fields_registry.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/static/lib/**",
    "**/static/description/**"
  ]
}
